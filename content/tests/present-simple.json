{"id":"present-simple-test","title":"Present Simple","description":"Проверка базовых правил.","level":"A2","tags":["grammar"],"questions":[{"id":"q1","prompt":"She ___ to work every day.","options":[{"id":"a","text":"go"},{"id":"b","text":"goes"},{"id":"c","text":"going"}],"correctOptionId":"b","explanation":"С he, she, it к глаголу добавляется -s."},{"id":"q2","prompt":"They ___ coffee in the morning.","options":[{"id":"a","text":"drink"},{"id":"b","text":"drinks"},{"id":"c","text":"drinking"}],"correctOptionId":"a","explanation":"С they используется базовая форма глагола."},{"id":"q3","prompt":"The sun ___ in the east.","options":[{"id":"a","text":"rise"},{"id":"b","text":"rises"},{"id":"c","text":"rising"}],"correctOptionId":"b","explanation":"Это факт, а с the sun нужна форма rises."},{"id":"q4","prompt":"___ you work remotely?","options":[{"id":"a","text":"Do"},{"id":"b","text":"Does"},{"id":"c","text":"Are"}],"correctOptionId":"a","explanation":"Вопрос с you строится через Do."},{"id":"q5","prompt":"He ___ like loud music.","options":[{"id":"a","text":"don't"},{"id":"b","text":"doesn't"},{"id":"c","text":"not"}],"correctOptionId":"b","explanation":"С he отрицание строится через doesn't."}]}
